[Unit]
Description=Refresh short-lived RogueHalla capture writer credentials
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/rh-alpha-capture/broker-capture-credentials.py
RuntimeDirectory=rh-alpha-capture-roles
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
TimeoutStartSec=60s
NoNewPrivileges=true
LimitCORE=0
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
