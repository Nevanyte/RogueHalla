[Unit]
Description=Encrypted off-host backup of RogueHalla live PostgreSQL and result spool
RequiresMountsFor=/srv/rh-alpha
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/rh-alpha/live-backup.env
ExecStart=/opt/rh-alpha/backup/host-backup.sh
TimeoutStartSec=20min
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/rh-alpha /run /var/lib/rh-alpha-backup
StandardOutput=journal
StandardError=journal
